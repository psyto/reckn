# Written by scripts/arc-demo.sh at boot: chain-specific addresses plus the two
# fixtures' proof bytes. Regenerated on every run, so committing it would be
# committing a snapshot of a throwaway chain.
dashboard/arc-demo-state.json
dashboard/video/node_modules/

# Per-line recording clips, cut from the film by dashboard/video/split-scenes.py. They are a
# derivative of two things that ARE committed -- reckn-demo-v3.mp4 and VO.md -- and they are
# regenerated whenever either moves, which today was six times. Committing them would put 13 MB
# of the same frames in the history on every take, and a stale clip is worse than no clip: it
# shows a line landing on a picture that has since changed.
dashboard/media/scenes/

# Raw output of zk-verdict/scripts/tempo-testnet.sh -- the receipts exactly as
# eth_getTransactionReceipt returned them. Every 32-byte value in it is already in
# tempo.json (measured 2026-09-12: 13 of 13, none missing), and tempo.json is the record the
# gates actually read -- tempo-receipts.sh, tempo-verify.sh and ac011.sh AC-3/AC-4 all check
# it against the chain. Committing this file would add a second copy of the same hashes that
# nothing checks, and an unchecked receipt is worse than no receipt because it looks like
# evidence. It is regenerated by the next run.
zk-verdict/contracts/tempo-run.json
