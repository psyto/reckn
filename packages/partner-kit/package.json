{
  "name": "@reckn/partner-kit",
  "version": "0.1.0",
  "description": "Open a Reckn deal, check one before you work on it, settle it on a proof, and verify the settlement \u2014 without reading an ABI.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "profiles",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build --silent && node --test --experimental-strip-types test/*.test.ts",
    "cli": "npm run build --silent && node dist/cli.js"
  },
  "dependencies": {
    "@noble/hashes": "^1.5.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.7.0"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "reckn": "./dist/cli.js"
  }
}